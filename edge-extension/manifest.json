{
  "manifest_version": 3,
  "name": "ChatGPT TTS Reader",
  "version": "1.34",
  "description": "An intelligent, content-aware TTS reader with highlighting and navigation for ChatGPT",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tts"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "profile.js",
        "modules/00-namespace.js",
        "modules/10-lifecycle.js",
        "modules/15-playback-lock.js",
        "modules/20-smart-copy-part1.js",
        "modules/20-smart-copy-part2.js",
        "modules/20-smart-copy-part3.js",
        "modules/25-prompt-send-part1.js",
        "modules/25-prompt-send-part2.js",
        "modules/30-media-boost.js",
        "modules/35-server-tts.js",
        "modules/40-voice.js",
        "modules/45-paragraph.js",
        "modules/50-text.js",
        "modules/55-selection.js",
        "modules/60-highlight.js",
        "modules/65-prewrap.js",
        "modules/70-auto-read.js",
        "modules/75-queue.js",
        "modules/80-flow.js",
        "modules/85-events.js",
        "modules/87-ui.js",
        "modules/90-scroll.js",
        "modules/92-notify.js",
        "modules/99-bootstrap.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*"
      ]
    }
  ]
}
